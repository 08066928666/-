    //引数の要素の値をコピーする
    function copyTo(target) {
        var nm = target.attr('name');
        if (nm.indexOf('sel_koshu2_cd') >= 0) {
            var toNm = 'koshu2_cd' + nm.substring(nm.indexOf("["));
            var toElmnt = $('input[name="' + toNm + '"]');
            if (toElmnt) {
                toElmnt.val(target.val());
                console.log(toElmnt.val());
            }
        }
    }

    // 工事項目選択事前処理
    beforeKojikomoku = function (settings, $target) {
        var kojibu_cd = $('#kojibu_cd').val();
        var kojibu_cd_edaban = $('#kojibu_cd_edaban').val();
        var koshu2_cd = null;
        var tr = $target.closest('tr')

        for (; ;) {
            //1つ前のtrを取得
            var prevTr = tr.prev("tr");

            //1つ前のtrがなければループ終了
            if (prevTr.length == 0) {
                break;
            }

            //1つ前のtrがテンプレート行ならループ終了
            if(!prevTr.prop('id').indexOf('templateRow')){
                break;
            }

            //行区分取得
            var row_kbn = $(prevTr).find(':input[name^=row_kbn]');

            //行区分が工種１ならループ終了
            if (row_kbn.val() == 1) {
                break;
            }

            //行区分が工種２ならその値を取得してループ終了
            if (row_kbn.val() == ROW_KBN_KOSHU2) {
                koshu2_cd = prevTr.find(':input[name^=sel_koshu2_cd]').val();
                break;
            }
            tr = prevTr;
        }
        settings.fields['gyosha'] = FLAG_ON;
        settings.fields['kojibu_cd'] = kojibu_cd;
        settings.fields['kojibu_cd_edaban'] = kojibu_cd_edaban;
        settings.fields['koshu2_cd'] = koshu2_cd;
        settings.initSearch = true;
        return settings;
    }

    // 工事項目選択時コールバック
    selectKojikomoku = function (items, $target) {
        var tr = $target.closest('tr')
        var koshu2_cd = $(tr).find(':input[name^=koshu2_cd]');
        var kojikomoku_id = $(tr).find(':input[name^=kojikomoku_id]');
        var taisho1 = $(tr).find(':input[name^=taisho1]');
        var taisho2 = $(tr).find(':input[name^=taisho2]');
        var koji_naiyo = $(tr).find(':input[name^=koji_naiyo]');
        var tani = $(tr).find(':input[name^=tani]');
        var tanka = $(tr).find(':input[name^=tanka]');
        var m_tanka = $(tr).find(':input[name^=m_tanka]');

        koshu2_cd.val(items['koshu2_cd']);
        kojikomoku_id.val(items['kojikomoku_id']);
        taisho1.val(items['taisho1']);
        taisho2.val(items['taisho2']);
        koji_naiyo.val(items['koji_naiyo']);
        tani.val(items['tani_name']);
        tanka.val(items['tanka']);
        m_tanka.val(items['tanka']);

        koshu2_cd.prop("readonly", true);
        kojikomoku_id.prop("readonly", true);
        taisho1.prop("readonly", true);
        taisho2.prop("readonly", true);
        koji_naiyo.prop("readonly", true);
        tani.prop("readonly", true);
        tanka.prop("readonly", true);

        //金額・負担金額を計算する
        culccost(tr);

        //合計覧を計算する
        JS_gyosha_total.calcGokei();
    }

    // 過去見積反映ボタンコールバック
