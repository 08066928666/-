 * 見積登録 JSファイル
 */
var J2008 = J2008 || {};
(function ($) {
    //ヘッダ行数
    var hdrRowCnt = 1;
    //テンプレート行数
    var tmpRowCnt = 4;

    //ロード時初期処理
    init();

    //ロード時初期処理
    function init() {

        //エラー表示領域を初期非表示にする
        $('#errors').hide();

        var init_tab = '1';

        var qs = location.search.match(/tab=(.*?)(&|$)/);
        if(qs){
            init_tab = qs[1];
        }

        switch(init_tab){
            case '2' :
                $('.nav-tabs a:eq(1)').click();
                break;
            case '3' :
                $('.nav-tabs a:eq(2)').click();
                break;
            default:
                $('.nav-tabs a:eq(0)').click();
                break;
        }

        $("table#Costs").tableHeadFixer();

        var allRows = $('table#Costs tr');
        //処理開始インデックス
        var st = hdrRowCnt + tmpRowCnt;

        var isReadOnly = true;
        if (!$('#mitsumori_status').val() || $('#mitsumori_status').val() == MITSUMORI_STATUS_TEISHUTSU) {
            isReadOnly = false;
        }

        for (var i = st, limit = allRows.length; i < limit; i++) {
            var tr = allRows.eq(i);
            //処理用インデックス
            var idx = i - st;
            //処理用インデックスを画面上に格納
            $('#idx').val(idx);

            //工事項目検索ボタン
            var komokuSearchModal = $(tr).find(':input[name^=komokuSearchModal]');

            if (isReadOnly) {
                if (komokuSearchModal) {
                    komokuSearchModal.prop("readonly", isReadOnly);
                    komokuSearchModal.prop("disabled", isReadOnly);
                }
            }

            tr.find(':input').each(function () {
                if (isReadOnly) {
                    //並べ替え不可にする
                    tr.addClass("unsortable");

                    $(this).attr('readonly', isReadOnly);

                    if ($(this).is('select')) {
                        $(this).prop("disabled", isReadOnly);
                    }
                }
            });

            var kojikomoku_id = $(tr).find(':input[name^=kojikomoku_id]');

            if (kojikomoku_id.length > 0) {
                if (kojikomoku_id.val().length > 0) {
                    var koshu2_cd = $(tr).find(':input[name^=koshu2_cd]');
                    var taisho1 = $(tr).find(':input[name^=taisho1]');
                    var taisho2 = $(tr).find(':input[name^=taisho2]');
                    var koji_naiyo = $(tr).find(':input[name^=koji_naiyo]');
                    var tani = $(tr).find(':input[name^=tani]');
                    var tanka = $(tr).find(':input[name^=tanka]');

                    koshu2_cd.prop("readonly", true);
                    kojikomoku_id.prop("readonly", true);
                    taisho1.prop("readonly", true);
                    taisho2.prop("readonly", true);
                    koji_naiyo.prop("readonly", true);
                    tani.prop("readonly", true);
                    tanka.prop("readonly", true);
                }
            }
        }

        if (!$('#mitsumori_status').val()) {
            //    do nothing
        } else if ($('#mitsumori_status').val() == MITSUMORI_STATUS_TEISHUTSU) {
            //見積ステータスが業者提出済の場合は一時保存はできない

            $('#btnIchijihozon').attr('disabled', true);
        } else {
            //見積ステータスが業者提出済よりも後のステージの場合は明細編集をさせない

            $('#btnAddKoshu1').attr('disabled', true);
            $('#btnAddKoshu2').attr('disabled', true);
            $('#btnAddMeisai').attr('disabled', true);
            $('#btnAddComment').attr('disabled', true);
            $('#btnKakoMitsumori').attr('disabled', true);
            $('#btnIchijihozon').attr('disabled', true);
            $('#keihi_wariai').attr('readonly', true);
            $('#sel_nebiki_kbn').attr('disabled', true);
            $('#nebiki_chi').attr('readonly', true);

            if ($('#mitsumori_status').val() == MITSUMORI_STATUS_SAITEISHUTSU || $('#mitsumori_status').val() == MITSUMORI_STATUS_JURYO) {

                $('#genchobi').attr('readonly', true);
                $('#jokyo').attr('readonly', true);
                $('#genin').attr('readonly', true);
                $('#taio_naiyo').attr('readonly', true);
                $('#mitsumori_kihon_biko').attr('readonly', true);

                $('#kojigyosha_biko').attr('readonly', true);
                $('#mitsumori_name').attr('readonly', true);
                $('#btnToroku').attr('disabled', true);

                $('#shodaku_kbn_yes').attr('disabled', true);
                $('#shodaku_kbn_no').attr('disabled', true);

                if ($('#shodaku_kbn_yes').prop('checked')) {
                    $('#lbl_shodaku_kbn_no').attr('disabled', true);
                    $('#lbl_shodaku_kbn_no').attr('readonly', true);
                } else {
                    $('#lbl_shodaku_kbn_yes').attr('disabled', true);
                    $('#lbl_shodaku_kbn_yes').attr('readonly', true);
                }
            }
        }

        if ($('#tenant_goibi').attr('readonly')) {
            $('#tenant_goibi').datepicker('destroy');
        }

        if ($('#genchobi').attr('readonly')) {
            $('#genchobi').datepicker('destroy');
        }

        //価格を再計算する
        if ($('#doSaikeisan').val() == FLAG_ON) {
            var allRows = $('table#Costs tr');
            //処理開始インデックス
            var st = hdrRowCnt + tmpRowCnt;

            for (var i = st, limit = allRows.length; i < limit; i++) {
                var tr = allRows.eq(i);

                if ($(tr).find(':input[name^=row_kbn]').val() == ROW_KBN_MEISAI) {
                    culccost(tr);
                }
            }
        }

        //合計覧を計算する
        JS_gyosha_total.calcGokei();

        //価格を再計算する = 過去見積反映の場合
        if ($('#doSaikeisan').val() == FLAG_ON) {
            //先頭タブの選択
            $('.nav-tabs a:eq(2)').click();
        }

        //データリストのイベント設定
        common.setDataList($('.datalist'));

        //リサイズ
        $('.resize_div').resizable({ alsoResize: ".scroll_div", handles: "s, e, se" });

        //ツールチップ設定
        $('#Costs').on('mouseover',':input:not(.datalist), select', function(e){
            var parent = $(this).closest('tr');
            var tooltip = $(parent).find('.disp-row-no').text() + '行目　';

            switch($(parent).find('[name^=row_kbn]').val()){
                case '1':
                    tooltip += $(parent).find(':input[name^=koshu1]').val();
                    break;
                case '2':
                    tooltip += $(parent).find(':input[name^=koshu2_koban]').val() + '　' +  $(parent).find('select[name^=sel_koshu2_cd] option:selected').text();
                    break;
                case '3':
                    tooltip += $(parent).find(':input[name^=taisho1]').val()
                        + '　' + $(parent).find(':input[name^=taisho2]').val()
                        + '　' + $(parent).find(':input[name^=koji_naiyo]').val()
                        + '　' + $(parent).find(':input[name^=basho]').val()
                        + '　' + $(parent).find(':input[name^=bui]').val();
                    break;
                case '4':
                    tooltip += $(parent).find(':input[name^=comment]').val();
                    break;
                default:
            }

            $(this).attr('title', tooltip)
                .tooltip({placement: 'bottom'})
                .tooltip('fixTitle')
                .tooltip('show');
        });

        $('#Costs').on('mouseleave',':input, select', function(e){
            $(this).tooltip('destroy');
        });

        // $('#Costs').on('click',':input, select', function(e){
        //     if($(this).attr('readonly')){
        //         $(this).tooltip('destroy');
        //     }
        // });

