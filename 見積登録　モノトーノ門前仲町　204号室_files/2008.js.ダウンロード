    //テンプレート行をコピーして追加する
    function addTemplate(tempRows) {
        var table = $('#Costs')[0];
        //複製行のインデックス（ヘッダ行、テンプレート行分を省く）
        var idx = table.rows.length - hdrRowCnt - tmpRowCnt;

        //処理用インデックスを格納
        $('#idx').val(idx);

        //idをクリア
        tempRows.removeAttr('id');

        //name、idを指定
        tempRows.find(':input').each(function () {
            var idx = $('#idx').val();
            setNameWithIndex($(this), idx);
        });

        //データリストのイベント設定
        common.setDataList(tempRows.find('.datalist'));

        // CSSクラスを設定
        tempRows.css('display', '');

        //表示用No
        tempRows.find('.disp-row-no').text(idx + 1);

        // 行追加を設定
        $(tempRows).appendTo(table);

        //追加行の先頭テキストボックスにフォーカス
        $(tempRows).find(':input[type=text]:first').focus();
    }

    //インデックスを0から振りなおす
    function reNumbering() {
        var allRows = $('table#Costs tr');
        //処理開始インデックス
        var st = hdrRowCnt + tmpRowCnt;

        //tempRowの次の行から処理を開始する
        for (var i = st, limit = allRows.length; i < limit; i++) {
            var tr = allRows.eq(i);
            //処理用インデックス
            var idx = i - st;

            //処理用インデックスを格納
            $('#idx').val(idx);

            tr.find(':input').each(function () {
                var idx = $('#idx').val();
                setNameWithIndex($(this), idx);
            });

            //表示用Noも更新
            tr.find('.disp-row-no').text(idx + 1);
        }
    }

    //追加要素に処理用インデックスを付与した名前を設定する
    function setNameWithIndex(target, idx) {
        var nm = target.attr('name');

        if (!nm) {
            return;
        }

        if (nm.indexOf('[') >= 0) {
            nm = nm.substring(0, nm.indexOf('['));
        }

        var newName = nm + '[' + idx + ']';
        target.attr('name', newName);
        target.attr('id', newName);
        console.log(target.attr('name'));
    }



