function culcfutankingaku(row) {
    var kingaku = $(row).find('[data-cost-kingaku]').val();
    var karinushikingaku = $(row).find('[data-cost-karinushikingaku]').val();
    var karinushiwariai = $(row).find('[data-cost-karinushiwariai]');
    var kashinushikingaku = $(row).find('[data-cost-kashinushikingaku]');
    var kashinushiwariai = $(row).find('[data-cost-kashinushiwariai]');

    if ($(row).find('[data-cost-karinushikingaku]').val() == "") {
        $(row).find('[data-cost-karinushikingaku]').val(0);
    }

    kingaku = (kingaku) ? kingaku : "0";
    karinushikingaku = (karinushikingaku) ? karinushikingaku : "0";
    if (kingaku.match(/^-?(\d|,)+(\.\d+)?$/) != null && karinushikingaku.match(/^-?(\d|,)+(\.\d+)?$/) != null) {
        $(kashinushikingaku).val(parseInt(kingaku.replace(/,/g, '')) - parseInt(karinushikingaku.replace(/,/g, '')));
        formatPrice($(kashinushikingaku));

        /* ↓↓↓↓ Rustic修正 ↓↓↓↓ */
        // $(karinushiwariai).val(parseInt(parseInt(karinushikingaku.replace(/,/g, '')) / parseInt(kingaku.replace(/,/g, '')) * 100));
        // $(kashinushiwariai).val(100 - $(karinushiwariai).val());
        if (parseInt(kingaku.replace(/,/g, '')) == 0) {
            $(karinushiwariai).val(0);
        } else {
            $(karinushiwariai).val(parseInt(parseInt(karinushikingaku.replace(/,/g, '')) / parseInt(kingaku.replace(/,/g, '')) * 100));
        }
        $(kashinushiwariai).val(100 - $(karinushiwariai).val());
        /* ↑↑↑↑↑↑↑↑↑↑↑↑↑↑ */
    } else {
        $(karinushiwariai).val('');
        $(kashinushikingaku).val('');
        $(kashinushiwariai).val('');
    }
}

