//金額フォーマット
(function ($) {
    $.fn.priceFormat = function () {
        var self = this;

        self.each(function () {
            if (isPriceFormat($(this))) {
                formatPrice($(this));
            }

            if (!isInputText($(this)))
                return;

            // フォーカス取得イベント設定。金額フォーマットを解除
            $(this).focus(function () {
                if (isPriceFormat($(this))) {
                    $(this).val($(this).val().replace(/,/g, ''));
                }

                $(this).select();
            });
            // フォーカス喪失イベント設定。金額フォーマットで整形
            $(this).blur(function () {
                if (isPriceFormat($(this))) {
                    formatPrice($(this));
                }
            });
        });

        function isPriceFormat($el) {
            var value = (isInputText($el) ? $el.val() : $el.text()).replace(/,/g, '');
            return value.match(/^-?\d+(\.\d+)?$/);
        }

        function formatPrice($el) {
            var values = (isInputText($el) ? $el.val() : $el.text()).split('.');
            var val = values[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1,');
            var digit = (values.length > 1) ? '.' + values[1] : ''
            if (isInputText($el)) {
                $el.val(val + digit);
            } else {
                $el.text(val + digit);
            }
        }

        function isInputText($el) {
            var el = $el.get(0);
            if (el.nodeName == 'INPUT' && (el.type == 'text' || el.type == 'number' || el.type == 'tel')) {
                return true;
            }
            return false;
        }

        return this;
    }
})(jQuery);

