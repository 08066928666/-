function getParam(name, url) {
    if (!url) url = window.location.href;
    name = name.replace(/[\[\]]/g, "\\$&");
    var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
        results = regex.exec(url);
    if (!results) return null;
    if (!results[2]) return '';
    return decodeURIComponent(results[2].replace(/\+/g, " "));
}

function heightControl(target, height) {
    var el = $(target).closest('div');
    var h = $(window).height() - el.offset().top - height;
    el.css("height", h + "px");
}


function isPriceFormat($el) {
    var value = (isInput($el) ? $el.val() : $el.text()).replace(/,/g, '');
    return value.match(/^-?\d+(\.\d+)?$/);
}

function formatPrice($el) {
    var values = (isInput($el) ? $el.val() : $el.text()).split('.');
    var val = values[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1,');
    var digit = (values.length > 1) ? '.' + values[1] : ''
    if (isInput($el)) {
        $el.val(val + digit);
    } else {
        $el.text(val + digit);
    }
}

function isInput(el) {
    var tag = $(el).get(0).tagName;
    return (tag == "INPUT" || tag == "SELECT" || tag == "TEXTAREA");
}

