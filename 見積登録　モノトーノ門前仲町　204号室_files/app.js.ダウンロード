    common.sumNumeric = function ($targets) {
        $targets.each(function () {
            var $target = $(this);
            var $inputs = $($target.data('selector'));
            var sumInput = function () {
                var sum = 0;
                $inputs.each(function () {
                    try {
                        //有効な数字のみ
                        var val = $(this).val().replace(/,/g, '');
                        var num = parseInt(val, 10);
                        if (num) sum += num;
                    } finally {
                    }
                });
                $target.val(common.formatComma(sum));
            };
            $inputs.on('change blur', sumInput);
        });
    }

    //桁で指定された値引き金額を返します
    common.getNebikiKingakuKeta = function (kingaku, keta) {
        if (keta == 0) {
            return 0;
        }
        var buf = kingaku / Math.pow(10, keta);

        if (kingaku >= 0) {
            buf = Math.floor(buf);
        } else {
            buf = Math.ceil(buf);
        }

        var kingakuNew = buf * Math.pow(10, keta);

        return kingaku - kingakuNew;
    }

    //割合で指定された値引き金額を返します
    common.getNebikiKingakuWariai = function (kingaku, percentage) {
        if (percentage == 0) {
            return 0;
        }
        return Math.floor(kingaku * percentage / 100);
    }
