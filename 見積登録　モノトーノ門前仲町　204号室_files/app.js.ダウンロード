//数量による単価変更
function suryotankahenko(cbculc, cbculcgokei, programid){

    //変更されたかどうかのフラグ
    var tankahenkoflg = 0;

    //対象の工事項目ID
    var targetid = $('#koji_komoku_detail_id').val().split(',');

    $(targetid).each(function(index1, val){
        if(val){
            //数量合計
            var total = 0;

            //対象行を格納する配列
            var targettrs = [];

            //対象行を格納
            var trs = $('input[type=hidden][name^=kojikomoku_id][value=' + val + ']').closest('tr');

            if(programid == '1010' || programid == '1014'){

                $(trs).each(function(index2, tr){

                    var row_no = $(tr).find(':input[name^=row_no]').val();

                    //新規追加された値かどうか
                    var isNew = false;

                    //追加行である
                    if (!row_no) {
                        isNew = true;
                    }

                    //修正された値かどうか
                    var isChanged = false;

                    //修正区分が修正後である
                    if(programid == '1010'){
                        var shusei_kbn = $(tr).find(':input[name^=shusei_kbn]').val();
                        if (shusei_kbn && shusei_kbn == SHUSEI_KBN_ATO) {
                            isChanged = true;
                        }
                    } else {
                        if ($(tr).find(':input[name^=isChanged]').val() == FLAG_ON) {
                            isChanged = true;
                        }
                    }

                    //削除された値かどうか
                    var isDeleted = false;

                    var delCheck = $(tr).find(':input[name^=delCheck]');

                    if(delCheck) {
                        if (delCheck.is(':checked')) {
                            isDeleted = true;
                        }
                    }

                    if (isNew) {
                        //追加
                        targettrs.push(tr);
                    } else if (isChanged) {
                        //１行前を削除して追加
                        targettrs.pop();
                        targettrs.push(tr)
                    } else if (isDeleted) {
                        //何もしない
                    } else {
                        //追加
                        targettrs.push(tr);
                    }
                });
            }else{
                targettrs = trs;
            }

            $(targettrs).each(function () {
                var suryo = $(this).find('[name^=suryo]').val();
                suryo = (suryo) ? suryo : "0";
                if (suryo.match(/^-?(\d|,)+(\.\d+)?$/) != null) {
                    total += parseFloat(suryo.replace(/,/g, ''));
                }
            });

            $('table#koji_komoku_detail tr').each(function () {
                if ($(this).find('td.kojikomoku_id').text() == val && parseFloat($(this).find('td.suryo_from').text().replace(/,/g, '')) <= total && total < parseFloat($(this).find('td.suryo_to').text().replace(/,/g, ''))) {
                    var tanka = parseInt($(this).find('td.tanka').text().replace(/,/g, ''));
                    $(targettrs).each(function () {
                        var tr = this;
                        var henkomae = parseInt($(tr).find('[name^=tanka]').val().replace(/,/g, ''));
                        if (henkomae != tanka) {
                            $(tr).find('[name^=tanka]').val(tanka).addClass('tankahenko');
                            //金額・負担金額を計算する
                            cbculc(tr);
                            tankahenkoflg = 1;
                        }else{
                            $(tr).find('[name^=tanka]').removeClass('tankahenko');
                        }
                    });
                }
            });
        }
    });

    if(tankahenkoflg == 1){
        //合計覧を計算する
        cbculcgokei();
        common.showMessage('数量により単価が変更されました。<br />確認後、再度ボタンを押下してください。');
        return true;
    }

    return false;
}

//全て再計算
function allculc(cbculc, cbculcgokei, programid, startidx, gokeiid, cbculcwarimodoshi){

    //現在の合計金額を取得
    var beforetotal = parseInt($('#' + gokeiid).text().replace(/,/g, ''));

    //明細を計算する
    var allRows = $('table#Costs tr');

    for (var i = startidx, limit = allRows.length; i < limit; i++) {
        var tr = allRows.eq(i);
        if ($(tr).find(':input[name^=row_kbn]').val() == 3) {
            cbculc(tr);
            if ($('#keihi_warimodoshi_flg_on').prop('checked')) {
                cbculcwarimodoshi(tr);
            }
        }
    }

    //合計覧を計算する
    cbculcgokei();

    var aftertotal = parseInt($('#' + gokeiid).text().replace(/,/g, ''));

    if(beforetotal != aftertotal){
        common.showMessage('再計算により合計金額が変更されました。<br />確認後、再度ボタンを押下してください。');
        return true;
    }

    return false;
}

