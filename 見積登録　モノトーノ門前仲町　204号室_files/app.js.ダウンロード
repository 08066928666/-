        common.confirmModal.modal(options);

        common.confirmModal.off('hidden.bs.modal');
        if (options) {
            var callback = options['callback'];
            if (callback) {
                common.confirmModal.find('.btn-yes').off('click');
                common.confirmModal.find('.btn-yes').on('click', callback);
            }
        }
    };

