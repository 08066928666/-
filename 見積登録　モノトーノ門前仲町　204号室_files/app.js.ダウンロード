        $('[data-input-clear*="true"]').click(function () {
            var selector = $(this).data('clear-selector');
            $(selector).each(function () {
                if (isInput(this)) {
                    if ($(this).attr('type') == 'radio') {
                        $(this).attr('checked', false);
                    } else {
                        $(this).val('');
                    }
                } else {
                    $(this).text('');
                }
            })
        });

        //共通イベント登録
        common.setCommonEvent($(document));
    });

