    common.ImgB64Resize = function(imgB64_src, callback) {
        //callback(imgB64_src);
        //return;
        // Image Type
        //var img_type = imgB64_src.substring(5, imgB64_src.indexOf(";"));
        var img_type = imgB64_src.substring(5, 'image/png');
        // Source Image
        var img = new Image();
        img.onload = function() {
            var width = img.naturalWidth;
            var height = img.naturalHeight;
            var resize_width = SHASHIN_WIDTH;
            var resize_height = SHASHIN_HEIGHT;
            if (width / resize_width >= height / resize_height) {
                resize_height = height * resize_width / width;
            }else{
                resize_width = width * resize_height / height;
            }

            // New Canvas
            var canvas = document.createElement('canvas');
            canvas.width = resize_width;
            canvas.height = resize_height;
            // Draw (Resize)
            var ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, resize_width, resize_height);
            // Destination Image
            var imgB64_dst = canvas.toDataURL(img_type);
            callback(imgB64_dst);
        };
        img.src = imgB64_src;
    }

    common.ImgB64Rotate = function(imgB64_src, callback, rotate) {
        var img_type = imgB64_src.substring(5, 'image/png');
        var img = new Image();
        img.onload = function() {
            var width = img.naturalWidth;
            var height = img.naturalHeight;

            var canvas = document.createElement('canvas');
            if(rotate == 90 || rotate == 270) {
                // swap w <==> h
                canvas.width = height;
                canvas.height = width;
            } else {
                canvas.width = width;
                canvas.height = height;
            }
            // Draw (Resize)
            var ctx = canvas.getContext('2d');
            if(rotate == 90) {
                ctx.rotate(rotate * Math.PI / 180);
                if(rotate == 90)
                    ctx.translate(0, -height);
                else if(rotate == 180)
                    ctx.translate(-width, -height);
                else if(rotate == 270)
                    ctx.translate(-width, 0);
            }
            ctx.drawImage(img, 0, 0, width, height);
            // Destination Image
            var imgB64_dst = canvas.toDataURL(img_type);
            callback(imgB64_dst);
        };
        img.src = imgB64_src;
    }

})(jQuery);