        //フォーム送信ボタンの登録
        $('form').find('button,input,a').on('click', common.submitBefore);

        //フォーム送信(AjaxForm以外)
        $('form').not('[data-remote=true]').on('submit', function () {
            var $form = $(this);

            if ($form.data('submited')) {
                return true;
            } else {
                $form.data('submited', true);
                //SubmitイベントがClickイベントより前に来るため遅延実行
                setTimeout(function () {
                    //ボタン名の設定
                    var $name = $form.find('[name=_submit_button_name]');
                    if ($name.length == 0) {
                        $name = $('<input>', {
                            type: 'hidden',
                            name: '_submit_button_name',
