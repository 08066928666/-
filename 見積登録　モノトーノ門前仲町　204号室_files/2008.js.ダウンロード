    //見積送信ボタン押下時処理
    J2008.update = function (form){

        if(suryotankahenko(culccost,JS_gyosha_total.calcGokei,'2008')){return;}

        if(allculc(culccost,JS_gyosha_total.calcGokei,'2008',hdrRowCnt + tmpRowCnt,'txt_gokei_kingaku')){return;}

        if($('#eSignModal')[0]){
            if (!J2008.eSignModal) {
                J2008.eSignModal = $('#eSignModal');
            }

            J2008.eSignModal.modal();
            J2008.eSignModal.find('.btn-yes').off('click');
            J2008.eSignModal.find('.btn-yes').on('click', function () {
                form.submit();
            });
        } else {
            form.submit();
        }
    };

