    /**
     * 任意の桁で四捨五入する関数
     * @param {number} value 四捨五入する数値
     * @param {number} base どの桁で四捨五入するか（小数第１位→10 小数第２位→100）
     * @return {number} 四捨五入した値
     */
    common.roundEx = function (value, base) {
        return Math.round(value * base) / base;
    }

    /**
     * 数値のカンマ編集
     * @param value
     * @returns {string}
     */
    common.formatComma = function (value) {
        value = value + '';
        var values = value.split('.');
        var val = values[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1,');
        var digit = (values.length > 1) ? '.' + values[1] : '';
        return val + digit;
    }

    /**
     * 数値を金額表記に編集(\nnn,nnn-)
     * @param value
     * @returns {string}
     */
    common.formatMoney = function (value) {
        return '\xA5' + common.formatComma(value) + '-';
    }

    /**
     * 関数判定
     * @param str
     * @returns {boolean}
     */
    common.canConvertFunc = function (str) {
        return typeof common.convertFunc(str) === 'function';
    }

    /**
     * 引数を関数に変換
     * @param str
     * @returns {*}
     */
    common.convertFunc = function (str) {
        try {
            if (typeof str === 'string') {
                var arr = str.split('.');
                var obj = window;
                for (i = 0; i < arr.length; i++) {
                    obj = obj[arr[i]];
                    if (!obj) return false;
                }
                return obj;
            } else {
                return str;
            }
        } catch (ex) {
            console.log(ex);
            return null;
        }
    }

