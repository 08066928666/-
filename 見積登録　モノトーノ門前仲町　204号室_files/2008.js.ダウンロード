    //タブ保持用のパラメータを設定
    J2008.setTabUrlParam = function(form){
        var index = $('ul.nav-tabs li').index($('ul.nav-tabs li.active'));
        if(index > 0) {
            var redirecturl = $(form).data('redirect-if-success');
            var pos = redirecturl.indexOf('?');
            if (pos < 0) {
                $(form).data('redirect-if-success', redirecturl + '?tab=' + (index + 1).toString())
            } else {
                $(form).data('redirect-if-success', redirecturl.substring(0, pos) + '?tab=' + (index + 1).toString())
            }
        }
    }
