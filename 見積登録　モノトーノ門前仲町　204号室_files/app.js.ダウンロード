var common = common || {};
var fileInput = fileInput || {};
(function ($) {

    /* 共通メソッド定義 Start */
    //jQueryのセレクタをエスケープ
    common.selectorEscape = function (val) {
        if (val) {
            return val.replace(/[ !"#$%&'()*+,.\/:;<=>?@\[\\\]^`{|}~]/g, '\\$&');
        } else {
            return val;
        }
    }

    //URLパラメーターを配列で取得
    common.getParams = function (url) {
        url = url || location.search;
        var params = {};
        var startIdx = url.indexOf('?');
        if (startIdx >= 0) {
            var pair = url.substr(startIdx + 1).split('&');
            for (var i = 0; pair[i]; i++) {
                var kv = pair[i].split('=');
                params[kv[0]] = kv[1];
            }
        }
        return params;
    }

    //全選択、全解除
    common.setCheckAllButton = function ($target) {
        $target.click(function () {
            var value = $(this).data('checkbox-all');
            var selector = $(this).data('checkbox-all-selector');
            if (value == 'check') {
                $(selector).prop('checked', true);
            } else {
                $(selector).prop('checked', false);
            }
        });
    }

    //データ同期
    common.setDataSync = function () {
        var $org = $(this);
        var name = $org.attr('name').replace('[', '\[');
        var $dest = $('[name=' + common.selectorEscape(name) + ']');
        var syncId = $org.data('sync-id');
        if (syncId) {
            $dest = $('[data-sync-id=' + syncId + ']');
        }
        switch ($org.attr('type').toUpperCase()) {
            case 'TEXT':
                $dest.val($org.val());
                break;
            case 'CHECKBOX':
                $dest.prop('checked', $org.prop('checked'));
                break;
        }
    }

