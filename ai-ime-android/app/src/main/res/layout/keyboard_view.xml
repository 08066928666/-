<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1C1C1E">

    <include
        android:id="@+id/lyric_include"
        layout="@layout/lyric_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mode_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="智能 ON" />

        <Button
            android:id="@+id/btn_smart"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="智能"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_lang"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="语言"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_clip"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="译剪贴板"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/preview_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="智能模式"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/send_preview_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="6dp"
        android:background="#262628"
        android:visibility="gone">

        <TextView
            android:id="@+id/send_preview_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/send_preview_line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/candidate_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:fillViewport="true"
        android:background="#2C2C2E">

        <LinearLayout
            android:id="@+id/candidate_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keyBackground="@drawable/key_bg"
        android:keyTextColor="#FFFFFF"
        android:background="#1C1C1E"
        android:keyPreviewLayout="@layout/key_preview" />
</LinearLayout>
